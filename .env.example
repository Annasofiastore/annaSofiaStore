# Copiar a .env.local y rellenar. .env.local nunca se commitea.

# ── Supabase ──────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role: salta RLS. Solo servidor, nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Sitio ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Correos separados por coma con acceso a /admin
ADMIN_EMAILS=

# ── Wompi (pagos) ─────────────────────────────────────────────
NEXT_PUBLIC_WOMPI_ENV=test
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# ── Resend (emails) ───────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── Cron ──────────────────────────────────────────────────────
# Token que valida las rutas de cron de Vercel
CRON_SECRET=
